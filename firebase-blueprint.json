{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing clinician credentials and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "description": "Clinical role or user type" },
        "specialty": { "type": "string", "description": "Clinical specialty" },
        "institution": { "type": "string", "description": "Clinical institution or clinic" },
        "rut": { "type": "string", "description": "Professional or personal RUT" },
        "registry": { "type": "string", "description": "Health professional registry number" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Pediatric patient primary record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Patient identifier" },
        "userId": { "type": "string", "description": "Owner clinician user ID" },
        "firstName": { "type": "string", "description": "Child first name" },
        "lastName": { "type": "string", "description": "Child last name" },
        "rut": { "type": "string", "description": "Patient RUT" },
        "birthDate": { "type": "string", "description": "Child birth date" },
        "gender": { "type": "string", "description": "Gender" },
        "diagnosis": { "type": "string", "description": "Medical admission diagnosis" },
        "medicalRecordNumber": { "type": "string", "description": "Medical record number" },
        "role": { "type": "string", "description": "Account role" },
        "plan": { "type": "string", "description": "Service plan" },
        "credits": { "type": "number", "description": "Session credits" },
        "assignedExercise": { "type": "string", "description": "Assigned exercise" },
        "emergencyContact": { "type": "object", "description": "Emergency contact" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["id", "userId", "firstName"]
    },
