    "ProgressNote": {
      "title": "ProgressNote",
      "description": "Clinical evolution and therapy session note including payment tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Note unique ID" },
        "userId": { "type": "string", "description": "Owner clinician user ID" },
        "patientId": { "type": "string", "description": "Patient ID" },
        "date": { "type": "string", "description": "Session date (MM/DD/YYYY or YYYY-MM-DD)" },
        "notes": { "type": "string", "description": "Clinical evolution and psychomotor progress" },
        "professionalName": { "type": "string", "description": "Treating professional" },
        "paymentMethod": { "type": "string", "description": "Payment method (Efectivo, Transferencia, Fonasa, etc.)" },
        "paymentStatus": { "type": "string", "description": "Payment status (Pagado, Pendiente, En convenio)" },
        "paymentAmount": { "type": "number", "description": "Session payment amount" },
        "paymentDate": { "type": "string", "description": "Payment date" },
        "sessionNumber": { "type": "number", "description": "Sequential session number" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["id", "userId", "patientId", "notes"]
    },
    "ComprehensiveReport": {
      "title": "ComprehensiveReport",
      "description": "Consolidated medical and kinesiology comprehensive report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Report ID" },
        "userId": { "type": "string", "description": "Owner clinician user ID" },
        "patientId": { "type": "string", "description": "Patient ID" },
        "patientName": { "type": "string", "description": "Patient full name" },
        "patientRut": { "type": "string", "description": "Patient RUT" },
        "patientBirthDate": { "type": "string", "description": "Birth date" },
        "medicalRecordNumber": { "type": "string", "description": "Medical record number" },
        "professionalName": { "type": "string", "description": "Professional name" },
        "professionalSpecialty": { "type": "string", "description": "Specialty" },
        "professionalRegistry": { "type": "string", "description": "Registry number" },
        "institution": { "type": "string", "description": "Institution" },
        "anamnesis": { "type": "object", "description": "Embedded anamnesis snapshot" },
        "evaluations": { "type": "object", "description": "Embedded evaluations snapshot" },
        "createdAt": { "type": "string", "description": "Creation date" }
      },
      "required": ["id", "userId", "patientId"]
    },
    "MarketingPlan": {
      "title": "MarketingPlan",
      "description": "Monthly marketing plan and content generated from anonymized clinic cases",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Plan unique ID" },
        "userId": { "type": "string", "description": "Owner clinician user ID" },
        "month": { "type": "string", "description": "Target month and year" },
        "pillars": { "type": "array", "description": "Content pillars" },
        "weeklyCalendar": { "type": "array", "description": "Weekly calendar posts" },
        "socialMediaHooks": { "type": "array", "description": "High conversion hooks" },
        "anonymizedCasesCount": { "type": "number", "description": "Number of cases analyzed" },
        "generatedAt": { "type": "string", "description": "Generation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["id", "userId", "month"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the authenticated clinician"
    },
    "/users/{userId}/patients/{patientId}": {
      "schema": "Patient",
      "description": "Collection of pediatric patients belonging to the clinician"
    },
    "/users/{userId}/anamnesis/{patientId}": {
      "schema": "Anamnesis",
      "description": "Clinical anamnesis records keyed by patientId"
    },
    "/users/{userId}/evaluations/{patientId}": {
      "schema": "Evaluation",
      "description": "Clinical evaluation records keyed by patientId"
    },
    "/users/{userId}/progressNotes/{noteId}": {
      "schema": "ProgressNote",
      "description": "Evolution and session progress notes with payments"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": "ComprehensiveReport",
      "description": "Consolidated medical and clinical reports"
    },
    "/users/{userId}/marketingPlan/{planId}": {
      "schema": "MarketingPlan",
      "description": "Monthly marketing plans generated from clinical data"
    },
    "/users/{userId}/migrationMeta/{metaId}": {
      "schema": "MigrationMeta",
      "description": "Migration metadata tracking local storage sync to Firestore"
    }
  }
}
