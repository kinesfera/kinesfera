rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all queries and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // User Profile: each authenticated user only accesses their own profile
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      // Patients subcollection
      match /patients/{patientId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(patientId);
      }

      // Anamnesis subcollection
      match /anamnesis/{patientId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(patientId);
      }

      // Clinical evaluations subcollection
      match /evaluations/{patientId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(patientId);
      }

      // Progress notes and session logs subcollection
      match /progressNotes/{noteId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(noteId);
      }

      // Medical and clinical reports subcollection
      match /reports/{reportId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(reportId);
      }

      // Marketing plan subcollection
      match /marketingPlan/{planId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(planId);
      }

      // Library files and documents subcollection
      match /libraryFiles/{fileId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(fileId);
      }

      // SPM age-based evaluations subcollection
      match /spmEvaluations/{evalId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(evalId);
      }

      // Critical communication skills subcollection
      match /communicationSkills/{commId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(commId);
      }

      // Migration metadata subcollection
      match /migrationMeta/{metaId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(metaId);
      }

      // Automatic cloud backups subcollection
      match /backups/{backupId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId) && isValidId(backupId);
      }
    }
  }
}
