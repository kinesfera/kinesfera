rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all queries and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile: each authenticated user only accesses their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Patients subcollection
      match /patients/{patientId} {
        allow read, write: if isOwner(userId) && isValidId(patientId);
      }

      // Anamnesis subcollection
      match /anamnesis/{patientId} {
        allow read, write: if isOwner(userId) && isValidId(patientId);
      }

      // Clinical evaluations subcollection
      match /evaluations/{patientId} {
        allow read, write: if isOwner(userId) && isValidId(patientId);
      }

      // Progress notes and session logs subcollection
      match /progressNotes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(noteId);
      }

      // Medical and clinical reports subcollection
      match /reports/{reportId} {
        allow read, write: if isOwner(userId) && isValidId(reportId);
      }

      // Marketing plan subcollection
      match /marketingPlan/{planId} {
        allow read, write: if isOwner(userId) && isValidId(planId);
      }

      // Migration metadata subcollection
      match /migrationMeta/{metaId} {
        allow read, write: if isOwner(userId) && isValidId(metaId);
      }
    }
  }
}
